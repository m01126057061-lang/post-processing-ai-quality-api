# ── Application ──────────────────────────────────────────────────────────────
DEBUG=false
VERSION=0.1.0

# ── Embedding model (coherence / relevance / fluency scorers) ──────────────
# Default: sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Quality defaults ─────────────────────────────────────────────────────────
DEFAULT_QUALITY_THRESHOLD=0.7

# ── AI Provider API keys ──────────────────────────────────────────────────────
# Leave blank to disable the corresponding provider adapter.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

