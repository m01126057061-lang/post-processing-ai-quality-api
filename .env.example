# ── Application ──────────────────────────────────────────────────────────────
DEBUG=false
VERSION=0.1.0

# ── Embedding model (coherence / relevance / fluency / hallucination scorers)
# Default: sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Embedding cache (per-text LRU entries) ───────────────────────────────────
# EMBEDDING_CACHE_SIZE=512

# ── Quality defaults ─────────────────────────────────────────────────────────
DEFAULT_QUALITY_THRESHOLD=0.7

# ── AI Provider API keys ──────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# ── Provider call settings ────────────────────────────────────────────────────
# PROVIDER_TIMEOUT_SECONDS=30.0
# PROVIDER_MAX_RETRIES=2

# ── Rate limits (requests per 60 seconds per IP) ──────────────────────────────
# RATE_LIMIT_EVALUATE=60
# RATE_LIMIT_FILTER=30
# RATE_LIMIT_PIPELINE=30
# RATE_LIMIT_PROVIDERS=20

# ── Audit trail ───────────────────────────────────────────────────────────────
# DB_PATH=./data/quality_audit.db
# AUDIT_ENABLED=true
